# Copy this file to .env.local and fill in your real values.
# EMAIL_USER must be a Gmail account that will SEND the message.
# EMAIL_PASS must be a 16-character Gmail "App Password" (not your normal password).
# The message will always be delivered to mumbonumber7@gmail.com (see pages/api/contact.js).

EMAIL_USER=your-sending-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
